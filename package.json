{
  "name": "bloommountain",
  "version": "0.2.0",
  "description": "Local Bloomberg-style terminal, public data only",
  "main": "app/main.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "tsx src/cli.tsx",
    "typecheck": "tsc",
    "analyst": "tsx scripts/analyst.ts",
    "forecaster": "tsx scripts/forecaster.ts",
    "discovery": "tsx scripts/discovery.ts",
    "connector": "tsx scripts/connector.ts",
    "site": "open site/index.html",
    "futures": "tsx scripts/futures.ts",
    "earnings": "tsx scripts/earnings.ts",
    "options": "tsx scripts/options.ts",
    "portfolio": "tsx scripts/portfolio.ts",
    "backtest": "tsx scripts/backtest.ts",
    "smartmoney": "tsx scripts/smartmoney.ts",
    "macro": "tsx scripts/macro.ts",
    "comps": "tsx scripts/comps.ts",
    "journal": "tsx scripts/journal.ts",
    "app": "electron .",
    "dist": "electron-builder --mac dmg"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "asciichart": "^1.5.25",
    "ink": "^7.1.1",
    "node-pty": "^1.1.0",
    "openai": "^6.49.0",
    "react": "^19.2.8",
    "tsx": "^4.23.1",
    "yahoo-finance2": "^4.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/asciichart": "^1.5.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "ninja.rockstar.bloommountain",
    "productName": "BloomMountain",
    "asar": false,
    "files": [
      "app/**/*",
      "src/**/*",
      "scripts/**/*",
      ".claude/**/*",
      "tsconfig.json",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "identity": null,
      "icon": "app/icon.icns"
    },
    "dmg": {
      "title": "BloomMountain",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
